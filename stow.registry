# Central Binary Executable & Distro Package Mapping Registry for Dotfiles Stow Manager

# =============================================================================
# Binary Executable Aliases
# Format: tool_name = binary1 | binary2 | ...
# =============================================================================
wl-clipboard = wl-copy | wl-paste
fd = fd | fdfind
rg = rg | ripgrep

# =============================================================================
# Distro Package Overrides
# Format: tool_name@distro_id = package_name
# =============================================================================
fd@ubuntu = fd-find
fd@debian = fd-find
fd@pop = fd-find
fd@mint = fd-find
rg@ubuntu = ripgrep
rg@debian = ripgrep
rg@pop = ripgrep
rg@mint = ripgrep
