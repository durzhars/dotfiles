# =============================================================================
# i3status Configuration — Catppuccin Mocha / Noctalia Theme
# =============================================================================

general {
    colors = true
    color_good = "#a6e3a1"      # Green
    color_degraded = "#f9e2af"  # Yellow
    color_bad = "#f38ba8"       # Red
    interval = 2
}

order += "volume master"
order += "disk /"
order += "cpu_usage"
order += "memory"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "tztime local"

volume master {
    format = "󰕾 %volume"
    format_muted = "󰖁 muted"
    device = "default"
    mixer = "Master"
    mixer_idx = 0
}

disk "/" {
    format = "󰋊 %avail"
}

cpu_usage {
    format = "󰍛 %usage"
    max_threshold = 75
}

memory {
    format = "󰘚 %used / %total"
    threshold_degraded = "1G"
    format_degraded = "MEMORY < %available"
}

wireless _first_ {
    format_up = "󰖩 %essid (%quality)"
    format_down = ""
}

ethernet _first_ {
    format_up = "󰈀 %ip"
    format_down = ""
}

battery all {
    format = "%status %percentage"
    format_down = ""
    status_chr = "󰂄"
    status_bat = "󰁹"
    status_unk = "󰂑"
    status_full = "󰁹"
    low_threshold = 20
    threshold_type = percentage
}

tztime local {
    format = "󰥔 %H:%M  󰃭 %d-%b-%Y"
}
